exports[`renders email steps with messaging templates and categories 1`] = `
[
  {
    "config": {
      "filters": {
        "actions": [
          {
            "id": "7",
            "type": "actions",
          },
        ],
        "filter_test_accounts": true,
      },
      "type": "event",
    },
    "id": "trigger_node",
    "name": "trigger_node",
    "type": "trigger",
  },
  {
    "config": {
      "inputs": {
        "email": {
          "value": {
            "templateId": "template-uuid",
            "to": {
              "email": "{{ person.properties.email }}",
            },
          },
        },
      },
      "message_category_id": "category-uuid",
      "template_id": "template-email",
    },
    "id": "welcome",
    "name": "welcome",
    "type": "function_email",
  },
  {
    "config": {
      "inputs": {
        "email": {
          "value": {
            "subject": "New buyer",
            "text": "See PostHog",
            "to": {
              "email": "ops@example.com",
            },
          },
        },
      },
      "template_id": "template-email",
    },
    "id": "inline",
    "name": "inline",
    "type": "function_email",
  },
  {
    "config": {
      "reason": "Sent",
    },
    "id": "done",
    "name": "done",
    "type": "exit",
  },
]
`;

