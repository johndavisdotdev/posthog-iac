{
    "typeName": "PostHog::ProductAnalytics::DataColorTheme",
    "description": "A PostHog data color theme: a named, ordered palette of series colors that insights and dashboards in a project can use.",
    "sourceUrl": "https://github.com/johndavisdev/posthog-iac",
    "documentationUrl": "https://posthog.com/docs/product-analytics/trends/charts",
    "definitions": {},
    "typeConfiguration": {
        "properties": {
            "ApiKey": {
                "description": "PostHog personal API key (phx_...) with the scopes this resource type needs. Pass it with a dynamic reference such as {{resolve:ssm-secure:/posthog/api-key}} when calling SetTypeConfiguration; never put it in plain text.",
                "type": "string",
                "minLength": 1
            },
            "BaseUrl": {
                "description": "PostHog API host. Leave unset for PostHog Cloud US (https://us.posthog.com); use https://eu.posthog.com for PostHog Cloud EU, or your instance URL when self-hosting.",
                "type": "string"
            }
        },
        "additionalProperties": false,
        "required": [
            "ApiKey"
        ]
    },
    "properties": {
        "ProjectId": {
            "description": "ID of the PostHog project the color theme belongs to.",
            "type": "string",
            "minLength": 1
        },
        "Id": {
            "description": "The PostHog data color theme ID.",
            "type": "string"
        },
        "Name": {
            "description": "Name of the theme.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        },
        "Colors": {
            "description": "Series colors in order, as CSS hex colors such as #1d4aff.",
            "type": "array",
            "insertionOrder": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "CreatedAt": {
            "description": "ISO 8601 creation timestamp.",
            "type": "string"
        }
    },
    "additionalProperties": false,
    "required": [
        "ProjectId",
        "Name"
    ],
    "readOnlyProperties": [
        "/properties/Id",
        "/properties/CreatedAt"
    ],
    "createOnlyProperties": [
        "/properties/ProjectId"
    ],
    "primaryIdentifier": [
        "/properties/ProjectId",
        "/properties/Id"
    ],
    "tagging": {
        "taggable": false
    },
    "handlers": {
        "create": {
            "permissions": []
        },
        "read": {
            "permissions": []
        },
        "update": {
            "permissions": []
        },
        "delete": {
            "permissions": []
        },
        "list": {
            "permissions": []
        }
    }
}
