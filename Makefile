# Root targets that run across every PostHog::* resource type.
# Each resource directory also has its own Makefile generated by `cfn init`.

SHELL := /bin/bash
CFN ?= $(CURDIR)/.venv/bin/cfn
export PATH := $(CURDIR)/.venv/bin:$(PATH)

RESOURCE_DIRS := $(sort $(patsubst %/,%,$(dir $(wildcard posthog-*/.rpdk-config))))

.PHONY: help venv list test vet validate generate build package check-packages collect-packages clean new

help:
	@echo "make venv        install the CloudFormation CLI + Go plugin into .venv"
	@echo "make list        list resource type directories"
	@echo "make test        go test the shared module and every resource type"
	@echo "make vet         go vet everything"
	@echo "make validate    cfn validate every schema"
	@echo "make generate    cfn generate every resource type (regenerates model.go)"
	@echo "make build       build every handler binary for Lambda (linux/amd64)"
	@echo "make package     build, then cfn submit --dry-run every resource type into <dir>/<dir>.zip,"
	@echo "                 the handler packages that patterns.PostHogResourceTypes uploads"
	@echo "make check-packages    fail unless every resource type has its <dir>/<dir>.zip"
	@echo "make collect-packages PACKAGE_DIR=dist/handlers   copy every zip into one flat folder"
	@echo "                 (pass it as handlerPackageDirectory when the CDK app is elsewhere)"
	@echo "make new TYPE=PostHog::Service::Resource   scaffold a new resource type"

venv:
	python3 -m venv .venv
	.venv/bin/pip install -q cloudformation-cli cloudformation-cli-go-plugin

list:
	@printf '%s\n' $(RESOURCE_DIRS)

test:
	cd internal/posthogcfn && go test ./...
	@set -e; for d in $(RESOURCE_DIRS); do echo "== $$d"; (cd $$d && go test ./...); done

vet:
	cd internal/posthogcfn && go vet ./...
	@set -e; for d in $(RESOURCE_DIRS); do (cd $$d && go vet ./...); done

validate:
	@set -e; for d in $(RESOURCE_DIRS); do echo "== $$d"; (cd $$d && $(CFN) validate && rm -f rpdk.log); done

generate:
	@set -e; for d in $(RESOURCE_DIRS); do echo "== $$d"; (cd $$d && $(CFN) generate >/dev/null && rm -f rpdk.log); done

build:
	@set -e; for d in $(RESOURCE_DIRS); do echo "== $$d"; (cd $$d && $(MAKE) -s build && rm -f rpdk.log); done

# `cfn submit --dry-run` writes <dir>/<dir>.zip but does not compile the Go
# handler: without bin/bootstrap the zip has no handler.zip. So build first.
# patterns.PostHogResourceTypes (constructs/) looks for exactly this layout
# under the repository root by default, so no copy step is needed.
package: build
	@set -e; for d in $(RESOURCE_DIRS); do echo "== $$d"; (cd $$d && $(CFN) submit --dry-run && rm -f rpdk.log); done
	@$(MAKE) -s check-packages

check-packages:
	@missing=0; for d in $(RESOURCE_DIRS); do if ! test -f $$d/$$d.zip; then echo "missing $$d/$$d.zip"; missing=1; \
	  elif ! unzip -l $$d/$$d.zip | grep -q ' handler.zip$$'; then echo "$$d/$$d.zip has no handler.zip (run make build)"; missing=1; fi; done; \
	test $$missing -eq 0 && echo "$(words $(RESOURCE_DIRS)) handler packages present"

PACKAGE_DIR ?= dist/handlers
collect-packages: check-packages
	@mkdir -p $(PACKAGE_DIR)
	@for d in $(RESOURCE_DIRS); do cp $$d/$$d.zip $(PACKAGE_DIR)/; done
	@echo "copied $(words $(RESOURCE_DIRS)) handler packages to $(PACKAGE_DIR)"

clean:
	@for d in $(RESOURCE_DIRS); do rm -rf $$d/bin $$d/*.zip $$d/rpdk.log; done

new:
	@test -n "$(TYPE)" || (echo "usage: make new TYPE=PostHog::Service::Resource" && exit 1)
	scripts/new-resource.sh $(TYPE)
